# Apache 2.4; requiere AllowOverride Options FileInfo AuthConfig en este directorio.
Options -Indexes
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(git|claude)(/|$) - [F,L]
</IfModule>
<FilesMatch "^(\.htaccess|\.gitignore|\.gitattributes)$">
    Require all denied
</FilesMatch>
